{
  "schemaVersion": "1.0.0",
  "package": "@konitif/workbench-runtime",
  "intent": "Assemble the Workbench runtime and coordinate its controllers without owning the hosted domains.",
  "clusters": [
    {
      "id": "store-and-modes",
      "title": "Store and modes",
      "summary": "Composite Workbench state and workspace manipulation modes.",
      "authority": "Local application coordination.",
      "owns": [
        "store",
        "current mode"
      ],
      "doesNotOwn": [
        "tool domains"
      ],
      "workflow": [
        "Create",
        "Configure",
        "Reduce"
      ],
      "sources": [
        "createWorkbenchStore.ts",
        "createWorkspaceModeController.ts",
        "createCoherentWorkbenchStore.ts"
      ]
    },
    {
      "id": "shell-runtime-actions",
      "title": "Shell and tool actions",
      "summary": "Application commands connecting the shell, panels, and tools.",
      "authority": "Orchestration of admitted intents.",
      "owns": [
        "shell actions",
        "tool runtime actions"
      ],
      "doesNotOwn": [
        "business meaning"
      ],
      "workflow": [
        "Receive",
        "Route",
        "Apply"
      ],
      "sources": [
        "workbenchShellActions.ts",
        "workbenchToolRuntimeActions.ts"
      ]
    },
    {
      "id": "experience-screen-navigation",
      "title": "Experience and screen navigation",
      "summary": "Experience links and browser history projected through host-supplied screen actions.",
      "authority": "The host admits experiences and owns screen activation.",
      "owns": ["URL encoding", "navigation coordination"],
      "doesNotOwn": ["experience identity", "experience admission", "workspace semantics"],
      "workflow": ["Read the requested reference", "Ask the host to activate", "Update browser history"],
      "sources": ["experienceTabLink.ts"]
    },
    {
      "id": "resource-library-adapters",
      "title": "Resource library adapters",
      "summary": "Durable browser folder organization and an HTTP client for a host-owned audio library.",
      "authority": "Workbench supplies folder semantics and the host owns resource storage and access.",
      "owns": ["browser persistence adapter", "HTTP request and response adaptation"],
      "doesNotOwn": ["canonical resource data", "resource access policy", "folder domain rules"],
      "workflow": ["Read current state", "Apply the shared folder operation or request host data", "Report success or failure"],
      "sources": ["workbenchLibraryFolderRepository.ts", "workbenchAudioLibraryClient.ts"]
    },
    {
      "id": "persistence-and-sync",
      "title": "Persistence and synchronization",
      "summary": "Restoration of layout, focus, and history.",
      "authority": "Persistent workspace state.",
      "owns": [
        "persisted shell",
        "focus",
        "history",
        "synchronization"
      ],
      "doesNotOwn": [
        "domain artifacts"
      ],
      "workflow": [
        "Capture",
        "Persist",
        "Rehydrate"
      ],
      "sources": [
        "workbenchShellPersistence.ts",
        "workbenchFocusPersistence.ts",
        "workspaceHistoryController.ts",
        "workspaceSyncController.ts",
        "coherentWorkbenchPersistence.ts"
      ],
      "symbolNames": [
        "WorkbenchHostEventHandlers",
        "WorkbenchHostEvents",
        "WorkbenchHostStorageChange"
      ]
    }
  ]
}
